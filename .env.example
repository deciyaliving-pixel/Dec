# Copy this file to .env and fill in real values. Never commit .env.

# --- Server (server/) ---------------------------------------------------
PORT=8787
SITE_URL=http://localhost:8787
NODE_ENV=development

# Supabase (server-side). When both are set, the API reads/writes a real
# Supabase Postgres project. When either is missing, the server falls back to
# an in-memory, seed-data-backed repository intended for local development
# only (all writes are lost on restart) — see README.md.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Local development only: lets the Studio editor be exercised without a live
# Supabase project, by treating all requests as an authenticated editor.
# Must never be set to "true" in production; the server ignores it whenever
# SUPABASE_URL/SUPABASE_SERVICE_ROLE_KEY are configured.
DEV_AUTH_BYPASS=false

# --- Client (client/), must be prefixed VITE_ to be exposed to the browser -
# Safe to expose: Supabase's anon key is designed for client-side use and is
# constrained by the Row Level Security policies in supabase/migrations.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
